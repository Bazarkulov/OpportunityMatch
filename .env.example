# Backend
DATABASE_URL=sqlite:///./opportunitymatch.db
AUTH_SECRET=replace-with-a-long-random-value
ACCESS_TOKEN_MINUTES=1440
CORS_ORIGINS=http://localhost:3000

# Optional PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/opportunitymatch

# Public collector board identifiers (comma-separated)
GREENHOUSE_BOARDS=figma
LEVER_SITES=xcimer,anybotics,hermeus
COLLECTOR_TIMEOUT_SECONDS=20
# Optional: enables POST /api/collection/refresh with X-Collection-Key
COLLECTION_ADMIN_TOKEN=

# Frontend (put in frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
